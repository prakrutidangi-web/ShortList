# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=shortlist
POSTGRES_PASSWORD=shortlist_dev_only
POSTGRES_DB=shortlist
# Host port for Postgres (5433 avoids clashes with a local Postgres)
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
WEB_HOST_PORT=3000
# Used when running the API natively (make dev); compose overrides host to "db"
DATABASE_URL=postgresql+psycopg://shortlist:shortlist_dev_only@localhost:5433/shortlist
NEXT_PUBLIC_API_URL=http://localhost:8000
