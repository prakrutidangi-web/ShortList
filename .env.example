# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=shortlist
POSTGRES_PASSWORD=shortlist_dev_only
POSTGRES_DB=shortlist
# Host port for Postgres (5433 avoids clashes with a local Postgres)
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
WEB_HOST_PORT=3000
# Used when running the API natively (make dev); compose overrides host to "db"
DATABASE_URL=postgresql+psycopg://shortlist:shortlist_dev_only@localhost:5433/shortlist
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- embeddings (Phase 2) ---
# real = bge-small-en-v1.5 (needs `make install-ml`); fake = deterministic hashing encoder for tests
EMBEDDING_BACKEND=real
# auto picks the Apple GPU (mps) when available, else cuda, else cpu
EMBEDDING_DEVICE=auto

# --- ingestion ---
# Raw API responses older than this many days are deleted after each run (and by `make clean-raw`).
RAW_RETENTION_DAYS=14
# Minimum seconds between requests to the same host. Keep >= 1 to respect the public APIs.
REQUEST_INTERVAL_S=1.0
# Defines "today" for the skip-if-already-fetched rule and the optional scheduler.
TIMEZONE=America/Phoenix
